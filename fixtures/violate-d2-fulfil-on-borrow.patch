+import { addDays, utcDay } from '../clock.js';
+import type { JobContext } from '../scheduler.js';
+
+export const WEEKLY_SUMMARY = 'weekly-summary';
+
+export type WeeklySummaryBody = {
+  period_start: string;
+  period_end: string;
+  borrows: number;
+  returns: number;
+  holds_placed: number;
+  holds_cancelled: number;
+  fines_charged: number;
+  fines_charged_cents: number;
+  fines_waived: number;
+  fines_waived_cents: number;
+};
+
+type ActionTotals = { action: string; count: number; cents: number };
+
+const COUNTED_ACTIONS = [
+  'loan.borrowed',
+  'loan.returned',
+  'hold.placed',
+  'hold.cancelled',
+  'fine.charged',
+  'fine.waived',
+];
+
+export function weeklySummary({ db, now }: JobContext): { report_id: number; period: string } {
+  const period = utcDay(now);
+  const periodStart = utcDay(new Date(addDays(`${period}T00:00:00.000Z`, -6)));
+  const start = `${periodStart}T00:00:00.000Z`;
+  const end = addDays(`${period}T00:00:00.000Z`, 1);
+
+  const rows = db
+    .prepare(
+      `SELECT action,
+              COUNT(*) AS count,
+              COALESCE(SUM(json_extract(data, '$.amount_cents')), 0) AS cents
+       FROM audit_log
+       WHERE at >= ? AND at < ?
+         AND action IN (${COUNTED_ACTIONS.map(() => '?').join(', ')})
+       GROUP BY action`,
+    )
+    .all(start, end, ...COUNTED_ACTIONS) as ActionTotals[];
+  const totals = new Map(rows.map((row) => [row.action, row]));
+
+  const body: WeeklySummaryBody = {
+    period_start: periodStart,
+    period_end: period,
+    borrows: totals.get('loan.borrowed')?.count ?? 0,
+    returns: totals.get('loan.returned')?.count ?? 0,
+    holds_placed: totals.get('hold.placed')?.count ?? 0,
+    holds_cancelled: totals.get('hold.cancelled')?.count ?? 0,
+    fines_charged: totals.get('fine.charged')?.count ?? 0,
+    fines_charged_cents: totals.get('fine.charged')?.cents ?? 0,
+    fines_waived: totals.get('fine.waived')?.count ?? 0,
+    fines_waived_cents: totals.get('fine.waived')?.cents ?? 0,
+  };
+
+  const result = db
+    .prepare('INSERT INTO reports (kind, period, generated_at, body) VALUES (?, ?, ?, ?)')
+    .run(WEEKLY_SUMMARY, period, now.toISOString(), JSON.stringify(body));
+
+  return { report_id: Number(result.lastInsertRowid), period };
+}
