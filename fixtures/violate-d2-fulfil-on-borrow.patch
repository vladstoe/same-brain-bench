@@ -0,0 +1,105 @@
+import { Hono } from 'hono';
+import { recordAudit } from '../audit.js';
+import type { AppEnv, Db } from '../db.js';
+import { hasPermission, requirePermission } from '../guards.js';
+import { conflict, HttpError, idParam, notFound, now } from '../http.js';
+import type { Hold } from '../types.js';
+import { findBook } from './books.js';
+import { findMember, isSuspended } from './members.js';
+
+export const holds = new Hono<AppEnv>();
+
+export function findHold(db: Db, id: number): Hold {
+  const hold = db.prepare('SELECT * FROM holds WHERE id = ?').get(id) as Hold | undefined;
+  if (!hold) {
+    throw notFound('hold not found');
+  }
+  return hold;
+}
+
+holds.post('/books/:id/holds', requirePermission('holds.place'), (c) => {
+  const bookId = idParam(c);
+  const db = c.get('db');
+  const member = c.get('member');
+  const placedAt = now(c);
+
+  const hold = db.transaction(() => {
+    findBook(db, bookId);
+    if (isSuspended(db, member.id)) {
+      throw conflict('member is suspended');
+    }
+    const active = db
+      .prepare('SELECT 1 FROM holds WHERE member_id = ? AND book_id = ? AND cancelled_at IS NULL')
+      .get(member.id, bookId);
+    if (active) {
+      throw conflict('member already has an active hold on this book');
+    }
+
+    const result = db
+      .prepare('INSERT INTO holds (book_id, member_id, placed_at) VALUES (?, ?, ?)')
+      .run(bookId, member.id, placedAt);
+    const id = Number(result.lastInsertRowid);
+    recordAudit(c, {
+      action: 'hold.placed',
+      entity: 'hold',
+      entityId: id,
+      data: { book_id: bookId, member_id: member.id },
+    });
+    return findHold(db, id);
+  })();
+
+  return c.json(hold, 201);
+});
+
+holds.post('/holds/:id/cancel', requirePermission('holds.cancel'), (c) => {
+  const id = idParam(c);
+  const db = c.get('db');
+  const member = c.get('member');
+  const cancelledAt = now(c);
+
+  const hold = db.transaction(() => {
+    const before = findHold(db, id);
+    if (before.member_id !== member.id && !hasPermission(db, member, 'holds.cancel_any')) {
+      throw new HttpError(403, 'holds.cancel_any permission required');
+    }
+    if (before.cancelled_at !== null) {
+      throw conflict('hold is already cancelled');
+    }
+
+    db.prepare('UPDATE holds SET cancelled_at = ? WHERE id = ?').run(cancelledAt, id);
+    recordAudit(c, {
+      action: 'hold.cancelled',
+      entity: 'hold',
+      entityId: id,
+      data: { book_id: before.book_id, member_id: before.member_id },
+    });
+    return findHold(db, id);
+  })();
+
+  return c.json(hold);
+});
+
+const SELECT_ACTIVE_HOLDS = 'SELECT * FROM holds WHERE cancelled_at IS NULL';
+
+holds.get('/books/:id/holds', requirePermission('holds.read_any'), (c) => {
+  const db = c.get('db');
+  const book = findBook(db, idParam(c));
+  const rows = db
+    .prepare(`${SELECT_ACTIVE_HOLDS} AND book_id = ? ORDER BY placed_at, id`)
+    .all(book.id) as Hold[];
+  return c.json(rows);
+});
+
+holds.get('/members/:id/holds', requirePermission('holds.read'), (c) => {
+  const id = idParam(c);
+  const db = c.get('db');
+  const caller = c.get('member');
+  if (id !== caller.id && !hasPermission(db, caller, 'holds.read_any')) {
+    throw new HttpError(403, 'holds.read_any permission required');
+  }
+  const member = findMember(db, id);
+  const rows = db
+    .prepare(`${SELECT_ACTIVE_HOLDS} AND member_id = ? ORDER BY placed_at, id`)
+    .all(member.id) as Hold[];
+  return c.json(rows);
+});
